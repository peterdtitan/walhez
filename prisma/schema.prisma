// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImageSource {
  STATIC
  UPLOAD
}

enum ReportType {
  EXPENSE
  INCOME
}

enum ReportCategory {
  PREVENTIVE_MAINTENANCE
  ROUTINE_SERVICING
  BREAKDOWN_REPAIR
  OPERATIONAL_EXPENSE
  RENTAL_INCOME
  PROJECT_INCOME
  OTHER_INCOME
}

model AdminUser {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Equipment {
  id              String                    @id @default(cuid())
  name            String
  slug            String                    @unique
  company         String
  model           String
  description     String
  imagePath       String
  imageSource     ImageSource               @default(STATIC)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  characteristics EquipmentCharacteristic[]
  reportEntries   ReportEntry[]

  @@index([name])
}

model EquipmentCharacteristic {
  id          String    @id @default(cuid())
  title       String
  value       String
  sortOrder   Int       @default(0)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, sortOrder])
}

model ReportEntry {
  id          String         @id @default(cuid())
  equipmentId String
  type        ReportType
  category    ReportCategory
  title       String
  description String
  amount      Int
  entryDate   DateTime
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  equipment   Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, type, entryDate])
  @@index([type, category])
}
